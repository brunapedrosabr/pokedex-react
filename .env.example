# Copie este arquivo para ".env" e coloque sua chave do Gemini.
# Crie a chave em: https://aistudio.google.com/apikey
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).
GEMINI_API_KEY=

# Opcional: modelo do Gemini. "gemini-flash-latest" aponta sempre para o Flash mais recente.
# GEMINI_MODEL=gemini-flash-latest

# Opcional: porta do servidor da IA (o Vite repassa /api para ela).
# API_PORT=3001
