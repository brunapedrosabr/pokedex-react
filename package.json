{
  "name": "pokedex-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,ia -c red,yellow \"vite\" \"node --watch server/index.js\"",
    "dev:web": "vite",
    "server": "node server/index.js",
    "build": "tsc -b && vite build",
    "preview": "concurrently -k -n web,ia -c red,yellow \"vite preview\" \"node server/index.js\"",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "description": "Pokédex interativa com React + Vite (Atividade 03)",
  "engines": {
    "node": ">=20.19"
  }
}
